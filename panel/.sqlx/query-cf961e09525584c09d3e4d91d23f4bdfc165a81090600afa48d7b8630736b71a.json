  "query": "\n        INSERT INTO firewall_rules (port, protocol, allow, description)\n        VALUES ($1, $2, $3, $4)\n        ON CONFLICT (port, protocol) DO UPDATE SET allow = EXCLUDED.allow, description = EXCLUDED.description\n        RETURNING id, port, protocol, allow, description\n        ",
