{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.email, u.password_hash, u.is_admin, u.totp_secret,\n               u.totp_enabled, u.created_at, u.updated_at\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.token_hash = $1 AND s.expires_at > now()\n        ",
