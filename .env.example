# Database connection string (PostgreSQL)
# For local dev with docker-compose.yml:
DATABASE_URL=postgres://scontrol:scontrol@127.0.0.1:55432/scontrol

# Bind address for panel-api HTTP server
PANEL_API_BIND=127.0.0.1:8080

# Unix domain socket for communication with panel-agent (root daemon)
PANEL_AGENT_SOCKET=/run/scontrol/agent.sock

# Base64-encoded 32-byte secret keys (generate via: openssl rand -base64 32)
# Required in production; ephemeral keys are generated with a warning if omitted in development.
PANEL_COOKIE_KEY=
PANEL_SECRET_KEY=

# Session expiration in hours (default: 168 = 7 days)
PANEL_SESSION_TTL_HOURS=168

# Number of parallel Compose deployment workers (1-16, default: min(num_cpus, 4))
PANEL_DEPLOY_WORKERS=2
