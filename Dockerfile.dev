# Development toolchains only; Compose mounts source and dependency caches.
FROM rust:1-bookworm AS api
RUN useradd --create-home --uid 1000 scontrol \
    && mkdir -p /workspace/panel/target /home/scontrol/.cargo \
    && chown -R scontrol:scontrol /workspace /home/scontrol/.cargo
ENV CARGO_HOME=/home/scontrol/.cargo \
    CARGO_TARGET_DIR=/workspace/panel/target
WORKDIR /workspace/panel
USER scontrol

FROM node:22-bookworm-slim AS frontend
WORKDIR /app
RUN mkdir node_modules && chown -R node:node /app
USER node
